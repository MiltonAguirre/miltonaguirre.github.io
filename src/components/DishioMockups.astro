---
// PLACEHOLDER: hand-drawn mockups of the Dishio app, not real screenshots.
// Replace each <div class="screen"> with an <img> of the real screen when available
// (e.g. /images/dishio/menu.webp), and drop the "Mockups for illustration" caption.

const stores = [
  { name: "Burger Stand", note: "Burgers and fries", tint: "bg-sun" },
  { name: "Sushi Bar", note: "Rolls and bowls", tint: "bg-mist" },
  { name: "La Pizzería", note: "Pizza by the slice", tint: "bg-sun/60" },
  { name: "Heladería", note: "Ice cream", tint: "bg-mist" },
];

const cart = [
  { item: "Classic burger", store: "Burger Stand", price: "$8.50" },
  { item: "Salmon roll x8", store: "Sushi Bar", price: "$11.00" },
  { item: "Two scoops", store: "Heladería", price: "$4.00" },
];
---

<figure class="mt-16 md:mt-20">
  <div
    class="-mx-4 flex snap-x snap-mandatory gap-6 overflow-x-auto px-4 pb-4 sm:-mx-8 sm:px-8 md:justify-between md:overflow-visible"
    role="img"
    aria-label="Mockup of three Dishio screens: the food court's store list, a single order with dishes from three stores for table 12, and the payment confirmation sent to each store."
  >
    <div class="phone" aria-hidden="true">
      <div class="screen">
        <p class="text-[11px] text-navy/60">Table 12</p>
        <p class="mt-0.5 text-[15px] font-bold leading-tight">What are you having today?</p>
        <div class="mt-3 rounded-lg bg-mist px-3 py-2 text-[11px] text-navy/50">Search dishes or stores</div>
        <ul class="mt-3 space-y-2">
          {stores.map((s) => (
            <li class="flex items-center gap-3 rounded-xl border border-navy/10 p-2">
              <span class={`h-9 w-9 shrink-0 rounded-lg ${s.tint}`}></span>
              <span>
                <span class="block text-[12px] font-semibold leading-tight">{s.name}</span>
                <span class="block text-[10px] text-navy/60">{s.note}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="phone" aria-hidden="true">
      <div class="screen">
        <p class="text-[11px] text-navy/60">Table 12</p>
        <p class="mt-0.5 text-[15px] font-bold leading-tight">Your order</p>
        <ul class="mt-3 divide-y divide-navy/10">
          {cart.map((c) => (
            <li class="flex justify-between gap-2 py-2">
              <span>
                <span class="block text-[12px] font-semibold leading-tight">{c.item}</span>
                <span class="block text-[10px] text-navy/60">{c.store}</span>
              </span>
              <span class="text-[12px] font-semibold">{c.price}</span>
            </li>
          ))}
        </ul>
        <div class="mt-auto">
          <div class="flex justify-between border-t border-navy/20 pt-2 text-[13px] font-bold">
            <span>Total</span><span>$23.50</span>
          </div>
          <div class="mt-3 rounded-full bg-cobalt py-2 text-center text-[12px] font-semibold text-white">Pay $23.50</div>
        </div>
      </div>
    </div>

    <div class="phone" aria-hidden="true">
      <div class="screen items-center justify-center text-center">
        <span class="grid h-14 w-14 place-items-center rounded-full bg-cobalt text-2xl font-bold text-white">✓</span>
        <p class="mt-4 text-[15px] font-bold leading-tight">Payment confirmed</p>
        <p class="mt-2 text-[11px] leading-snug text-navy/70">
          Your order went to 3 stores.
        </p>
        <div class="mt-5 w-full space-y-1.5 text-left text-[11px]">
          {cart.map((c) => (
            <p class="flex justify-between rounded-lg bg-mist px-3 py-1.5">
              <span>{c.store}</span><span class="text-cobalt">Sent</span>
            </p>
          ))}
        </div>
      </div>
    </div>
  </div>
  <figcaption class="mt-2 text-[13px] text-navy/60">Mockups for illustration.</figcaption>
</figure>

<style>
  .phone {
    flex: 0 0 auto;
    width: 15rem;
    scroll-snap-align: center;
    border-radius: 2.25rem;
    border: 10px solid #0e1b4d;
    background: #0e1b4d;
    box-shadow: 0 24px 40px -24px rgb(14 27 77 / 0.55);
  }
  .screen {
    display: flex;
    flex-direction: column;
    aspect-ratio: 9 / 18;
    overflow: hidden;
    border-radius: 1.6rem;
    background: #fff;
    padding: 1.5rem 1rem 1rem;
    color: #0e1b4d;
  }
</style>
