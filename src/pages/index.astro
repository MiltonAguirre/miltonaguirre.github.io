---
import { Icon } from "astro-icon";
import Layout from "../layouts/main.astro";
import DishioMockups from "../components/DishioMockups.astro";

const email = "milton.aguirre92@gmail.com";
const linkedin = "https://www.linkedin.com/in/milton-luis-aguirre/";
const github = "https://github.com/MiltonAguirre";

const dishioSteps = [
  { title: "See every menu", body: "Browse all the stores in the food court from one app." },
  { title: "Order from the table", body: "Pick dishes from any store without standing in line." },
  { title: "Pay in the app", body: "Checkout runs through the built-in payment gateway." },
];

const experience = [
  {
    company: "Improve-in S.R.L",
    place: "Buenos Aires, Argentina",
    role: "Full-stack developer",
    dates: "2023 to now",
    points: [
      "Build full-stack web apps with React, Next.js, Express and TypeScript, from database design to the interface.",
      "Built integrations for enterprise platforms: WhatsApp Embedded Signup, OAuth token exchange and webhook processing.",
      "Refactored legacy document models and MySQL/MariaDB schemas with Prisma to speed up metadata search and media handling.",
      "Designed a JSON-driven UI system that renders tree-structured screens across the stack.",
      "Added structured logging, strict linting and query optimizations to cut technical debt and response times.",
    ],
  },
  {
    company: "Tracker Dev",
    place: "Santa Fe, Argentina",
    role: "Full-stack developer",
    dates: "2020 to 2023",
    points: [
      "Built and maintained web and cross-platform mobile apps with React, React Native, Node.js and Express.",
      "Designed and tuned relational schemas in MySQL/MariaDB with Sequelize and Prisma.",
      "Worked directly with clients to scope features, plan roadmaps and ship to production.",
    ],
  },
  {
    company: "Aries Ingeniería S.A.",
    place: "Santa Fe, Argentina",
    role: "Monitoring and systems operations specialist",
    dates: "2017 to 2019",
    points: [
      "Monitored alarm and telecom infrastructure and handled incidents under strict response times.",
    ],
  },
];

const skills = [
  { group: "Frontend", items: "React, Next.js, React Native, TypeScript, Tailwind CSS, Chakra UI" },
  { group: "Backend", items: "Node.js, Express, REST APIs, webhooks, OAuth, PHP with Laravel and Symfony" },
  { group: "Data", items: "MySQL, MariaDB, Prisma, Sequelize, indexing, query optimization, full-text search" },
  { group: "Tooling", items: "Git, GitHub, Docker, ESLint, Prettier, Pino, Postman, Linux and macOS" },
];

const projects = [
  {
    name: "BarberOn",
    body: "Cross-platform app for booking barbershop appointments, with its own API.",
    stack: "React Native, PHP",
    links: [
      { label: "App code", href: "https://github.com/MiltonAguirre/barberon-app" },
      { label: "API code", href: "https://github.com/MiltonAguirre/barberon-api" },
    ],
  },
  {
    name: "CinemaHub API",
    body: "API for adding and looking up movies and TV shows.",
    stack: "PHP",
    links: [{ label: "Code", href: "https://github.com/MiltonAguirre/cinemahub-api" }],
  },
  {
    name: "Casita robada",
    body: "The classic Argentine card game.",
    stack: "C++",
    links: [{ label: "Code", href: "https://github.com/MiltonAguirre/casita-robada" }],
  },
];
---

<Layout
  title="Milton Aguirre, full-stack developer"
  description="Full-stack developer from Santa Fe, Argentina, with six years building web and mobile apps. Founder of Dishio, a food court ordering app."
>
  <header class="on-cobalt relative bg-cobalt text-white">
    <nav class="mx-auto flex max-w-6xl justify-end gap-6 px-4 pt-5 text-[15px] font-semibold sm:px-8" aria-label="Sections">
      <a class="underline-offset-4 hover:underline" href="#dishio">Dishio</a>
      <a class="underline-offset-4 hover:underline" href="#experience">Experience</a>
      <a class="underline-offset-4 hover:underline" href="#contact">Contact</a>
    </nav>

    <div class="mx-auto grid max-w-6xl items-end gap-8 px-4 pb-14 pt-8 sm:px-8 md:grid-cols-[minmax(0,1fr)_min(28vw,380px)] md:pb-20 md:pt-12">
      <img
        src="/images/profile.webp"
        width="720"
        height="720"
        alt="Milton Aguirre smiling in sunglasses on a sunny street"
        class="w-40 sm:w-52 md:order-2 md:w-full"
      />
      <div class="md:order-1">
        <h1 class="name font-display font-black uppercase leading-[0.86] tracking-tight">
          <span class="block">Milton</span>
          <span class="block">Aguirre</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/90 md:text-xl">
          Full-stack developer. For six years I've built web and mobile apps end to end, from the database schema to
          the screen people tap. I also founded <a href="#dishio" class="font-semibold underline underline-offset-4">Dishio</a>,
          a food court ordering app.
        </p>
        <p class="mt-3 text-[15px] text-white/75">Santo Tomé, Santa Fe, Argentina. Spanish and English.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={`mailto:${email}`}
            class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-3 font-semibold text-cobalt transition-colors hover:bg-mist"
          >
            <Icon name="mdi:email-outline" class="h-5 w-5" aria-hidden="true" />
            Email me
          </a>
          <a
            href={linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full border-2 border-white/70 px-5 py-3 font-semibold transition-colors hover:border-white hover:bg-cobalt-deep"
          >
            <Icon name="mdi:linkedin" class="h-5 w-5" aria-hidden="true" />
            LinkedIn
          </a>
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full border-2 border-white/70 px-5 py-3 font-semibold transition-colors hover:border-white hover:bg-cobalt-deep"
          >
            <Icon name="mdi:github" class="h-5 w-5" aria-hidden="true" />
            GitHub
          </a>
        </div>
      </div>
    </div>
  </header>

  <main>
    <section id="dishio" class="bg-sun" aria-labelledby="dishio-title">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-8 md:py-24">
      <div class="grid gap-12 md:grid-cols-[5fr_6fr]">
        <div>
          <h2 id="dishio-title" class="font-display text-6xl font-black leading-none tracking-tight md:text-7xl">Dishio</h2>
          <p class="mt-3 text-lg font-semibold">Founder and developer</p>
          <p class="mt-6 max-w-prose text-lg leading-relaxed">
            In a food court, every store has its own counter, its own line and its own register. Dishio puts all of
            them in one app: guests see every menu, order from their table and pay without getting up.
          </p>
          <p class="mt-4 max-w-prose text-lg leading-relaxed">
            I founded Dishio and designed and developed the product myself, including the ordering flow and the
            payment gateway integration.
          </p>
        </div>

        <ol class="grid content-start gap-8" aria-label="How Dishio works">
          {dishioSteps.map((step, i) => (
            <li class="grid grid-cols-[auto_1fr] items-baseline gap-x-5 border-t-2 border-navy/20 pt-5">
              <span class="w-8 font-display text-4xl font-black text-cobalt" aria-hidden="true">{i + 1}</span>
              <div>
                <h3 class="text-xl font-bold">{step.title}</h3>
                <p class="mt-1 leading-relaxed text-navy/80">{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <DishioMockups />
      </div>
    </section>

    <section id="experience" class="mx-auto max-w-6xl px-4 py-16 sm:px-8 md:py-24" aria-labelledby="experience-title">
      <h2 id="experience-title" class="font-display text-4xl font-bold tracking-tight text-cobalt md:text-5xl">
        Experience
      </h2>
      <ol class="mt-10 border-l-2 border-cobalt/20">
        {experience.map((job) => (
          <li class="relative pb-12 pl-6 last:pb-0 md:grid md:grid-cols-[11rem_1fr] md:gap-8 md:pl-8">
            <span class="absolute -left-[7px] top-2 h-3 w-3 rounded-full bg-cobalt" aria-hidden="true"></span>
            <p class="font-semibold text-cobalt">{job.dates}</p>
            <div class="mt-1 md:mt-0">
              <h3 class="text-xl font-bold">{job.role}, {job.company}</h3>
              <p class="text-[15px] text-navy/70">{job.place}</p>
              <ul class="mt-4 max-w-prose list-disc space-y-2 pl-5 leading-relaxed marker:text-cobalt/50">
                {job.points.map((point) => <li>{point}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="bg-mist" aria-labelledby="skills-title">
      <div class="mx-auto grid max-w-6xl gap-12 px-4 py-16 sm:px-8 md:grid-cols-2 md:py-24">
        <div>
          <h2 id="skills-title" class="font-display text-4xl font-bold tracking-tight text-cobalt md:text-5xl">
            What I work with
          </h2>
          <dl class="mt-8 space-y-5">
            {skills.map((s) => (
              <div>
                <dt class="font-bold">{s.group}</dt>
                <dd class="mt-1 leading-relaxed text-navy/80">{s.items}</dd>
              </div>
            ))}
          </dl>
        </div>
        <div>
          <h2 class="font-display text-4xl font-bold tracking-tight text-cobalt md:text-5xl">Education</h2>
          <dl class="mt-8 space-y-5">
            <div>
              <dt class="font-bold">Computer Engineering studies</dt>
              <dd class="mt-1 leading-relaxed text-navy/80">Universidad Nacional del Litoral, Santa Fe</dd>
            </div>
            <div>
              <dt class="font-bold">Computer technician</dt>
              <dd class="mt-1 leading-relaxed text-navy/80">E.E.T. N° 322 Obispo Gelabert, Santo Tomé</dd>
            </div>
            <div>
              <dt class="font-bold">Languages</dt>
              <dd class="mt-1 leading-relaxed text-navy/80">Spanish, native. English, upper-intermediate to advanced.</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-16 sm:px-8 md:py-24" aria-labelledby="projects-title">
      <h2 id="projects-title" class="font-display text-4xl font-bold tracking-tight text-cobalt md:text-5xl">
        Side projects
      </h2>
      <ul class="mt-10 divide-y divide-cobalt/15 border-y border-cobalt/15">
        {projects.map((p) => (
          <li class="grid gap-2 py-6 md:grid-cols-[14rem_1fr_auto] md:items-baseline md:gap-8">
            <h3 class="text-xl font-bold">{p.name}</h3>
            <p class="leading-relaxed">
              {p.body} <span class="text-navy/70">Built with {p.stack}.</span>
            </p>
            <p class="flex gap-4">
              {p.links.map((l) => (
                <a
                  href={l.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-semibold text-cobalt underline underline-offset-4 hover:text-navy"
                >
                  {l.label}
                </a>
              ))}
            </p>
          </li>
        ))}
      </ul>
    </section>
  </main>

  <footer id="contact" class="on-cobalt bg-cobalt text-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-8 md:py-24">
      <h2 class="font-display text-4xl font-bold tracking-tight md:text-5xl">Let's talk</h2>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-white/90">
        Hiring a full-stack developer, or interested in Dishio? Write to me.
      </p>
      <a
        href={`mailto:${email}`}
        class="mt-8 inline-block break-words font-display text-[1.35rem] font-bold underline decoration-white/40 underline-offset-8 hover:decoration-white sm:text-4xl"
      >
        {email}
      </a>
      <div class="mt-10 flex gap-6 font-semibold">
        <a href={linkedin} target="_blank" rel="noopener noreferrer" class="underline-offset-4 hover:underline">LinkedIn</a>
        <a href={github} target="_blank" rel="noopener noreferrer" class="underline-offset-4 hover:underline">GitHub</a>
      </div>
    </div>
  </footer>
</Layout>

<style>
  .name {
    font-size: clamp(3.25rem, 11vw, 8.5rem);
    font-stretch: 115%;
  }
  @media (min-width: 768px) {
    .name {
      /* Sized so "AGUIRRE" at full stretch never runs under the photo column. */
      font-size: clamp(4rem, 6.6vw, 7.5rem);
      font-stretch: 150%;
    }
  }
  /* The one orchestrated moment: the name stretches open on load. */
  @media (prefers-reduced-motion: no-preference) {
    .name {
      animation: stretch-open 900ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    @keyframes stretch-open {
      from {
        font-stretch: 60%;
        opacity: 0;
      }
    }
  }
</style>
